---
layout: layouts/blogshell.njk
---
{%- for post in collections.blogPosts | listPosts(blog, listing, listingKey) %}
<div id="blog-post-{{ post.data.postId }}" class="blog-post">
		<div class="blog-header">
			<h2 class="blog-title">
					<a class="blog-title-link blog-link" href="{{ post.data.permalink }}">{{ post.data.postTitle }}</a>
			</h2>
			<p class="blog-date">
					<span class="date-text">{{ post.data.dateText }}</span>
			</p>
		</div>
		<div class="blog-separator">&nbsp;</div>
		<div class="blog-content">
{{ post.templateContent | safe }}
		</div>
		<div class="blog-post-separator"></div>
</div>
{%- endfor %}
