{%- macro subnav(items, current) -%}
<div class="wsite-menu-wrap" style="display:none">
	<ul class="wsite-menu">
{%- for it in items %}
		<li id="{{ it.id }}"
	class="wsite-menu-subitem-wrap {% if it.url and it.url == current %}wsite-nav-current{% endif %}"
	>
	<a
		{% if it.url %}href="{{ it.url }}"{% endif %}
		class="wsite-menu-subitem"
		>
		<span class="wsite-menu-title">
			{{ it.title }}
		</span>{% if it.children %}<span class="wsite-menu-arrow">&gt;</span>{% endif %}
	</a>
	{% if it.children %}{{ subnav(it.children, current) }}{% endif %}
</li>
{%- endfor %}
	</ul>
</div>
{%- endmacro -%}
